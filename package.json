{
  "name": "sidcraft-syntex",
  "private": true,
  "description": "Build tooling for the Sidcraft Syntex editor bundle (assets/js/editor.js).",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "lint": "eslint src && prettier --check src scripts",
