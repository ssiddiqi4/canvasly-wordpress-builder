    "compare": "node scripts/compare-bundle.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-scope": "8.4.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
